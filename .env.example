# CampusConnect - Environment Configuration Template
# Copy this file to .env and configure values before starting:
#   Windows: Copy-Item .env.example .env
#   Linux/macOS: cp .env.example .env

# Application Environment: 'production' or 'development'
# In development, an ephemeral key is used if SECRET_KEY is omitted.
# In production, a secure non-default SECRET_KEY is strictly required (app will fail safely if missing or default).
FLASK_ENV=development

# Strong production secret key (generate via: python -c "import secrets; print(secrets.token_hex(32))")
# NEVER commit the actual .env file with real secrets into version control.
SECRET_KEY=replace-with-generated-32-byte-hex-secret-in-production

# Secure Cookies: 'true' when deployed behind HTTPS/TLS (recommended for production)
SESSION_COOKIE_SECURE=false

# Database Path (defaults to campusconnect.db in the project root if omitted)
# For persistent container storage, set this to an absolute path or persistent volume mount.
CAMPUSCONNECT_DB=campusconnect.db

# Upload Storage Directory (defaults to uploads/ in project root if omitted)
CAMPUSCONNECT_UPLOAD_DIR=uploads

# Demo Data Auto-Seeding: '0' for production (default), '1' only for demo environments
CAMPUSCONNECT_SEED_DEMO=0

# Rate Limiter Storage URI: 'memory://' (single-process) or 'redis://localhost:6379/0' (multi-worker)
RATELIMIT_STORAGE_URI=memory://

# Number of reverse proxies (e.g., 1 for Nginx or AWS ALB; 0 for direct execution)
NUM_PROXIES=0

# Server Binding Configuration
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000
